# Copia este archivo a .env para desarrollo local. En Cloud Run, las variables
# marcadas SECRETO van como referencia a Secret Manager. No dejes espacios antes
# ni después de los valores.

# ── JWT ──────────────────────────────────────────────────────────────────

# Llave HMAC para tokens HS256 legacy (sin "kid" en el header).
# OBLIGATORIA solo si JWT_ACCEPT_LEGACY=true. SECRETO (Secret Manager). Sin default.
JWT_SECRET=

# Endpoint JWKS del emisor de tokens (llaves públicas RS256).
# OBLIGATORIA, no es secreto (es una URL pública). Sin default.
JWT_JWKS_URI=https://<URL-del-User-en-Cloud-Run>/.well-known/jwks.json

# Claim "iss" esperado en el token.
# No obligatoria, no es secreto. Default: myanimalog-user-service
JWT_ISSUER=myanimalog-user-service

# Claim "aud" esperado en el token (debe estar contenido en el "aud" del token).
# No obligatoria, no es secreto. Default: myanimalog-api
JWT_AUDIENCE=myanimalog-api

# Si "true", además de RS256 (JWKS) se siguen aceptando tokens HS256 legacy
# firmados con JWT_SECRET. Pon "false" cuando ya no quede ningún cliente con
# un token pre-RS256.
# No obligatoria, no es secreto. Default: true
JWT_ACCEPT_LEGACY=true

# ── URLs de servicios downstream ────────────────────────────────────────

# URL del User service.
# No obligatoria, no es secreto. Default: http://localhost:8080
USER_SERVICE_URL=https://<servicio>-<proyecto>.us-central1.run.app

# URL del Pets service.
# No obligatoria, no es secreto. Default: http://localhost:8081
PET_SERVICE_URL=https://<servicio>-<proyecto>.us-central1.run.app

# URL del Veterinary service.
# No obligatoria, no es secreto. Default: http://localhost:8082
VETERINARY_SERVICE_URL=https://veterinary-microservice-petsapp-20369076707.us-central1.run.app

# URL del Medical Pet service.
# No obligatoria, no es secreto. Default: http://localhost:3000
MEDICAL_SERVICE_URL=https://<servicio>-<proyecto>.us-central1.run.app

# URL del Calendar service.
# No obligatoria, no es secreto. Default: http://localhost:3001
CALENDAR_SERVICE_URL=https://<servicio>-<proyecto>.us-central1.run.app

# URL del Notification service.
# No obligatoria, no es secreto. Default: http://localhost:3002
NOTIFICATION_SERVICE_URL=https://<servicio>-<proyecto>.us-central1.run.app

# ── CORS ─────────────────────────────────────────────────────────────────

# Lista de orígenes permitidos separados por coma (cada uno se recorta con
# trim, así que un espacio después de la coma no rompe nada).
# No obligatoria, no es secreto. Default: ${FRONTEND_URL} si está definida,
# si no: http://localhost:8100,http://localhost:4200
FRONTEND_URLS=http://localhost:8100,http://localhost:4200

# Origen único (forma legacy). Solo se usa si FRONTEND_URLS no está definida.
# No obligatoria, no es secreto. Sin default propio (ver FRONTEND_URLS).
FRONTEND_URL=

# ── Redis (rate limiting) ───────────────────────────────────────────────

# Host de Redis.
# No obligatoria, no es secreto. Default: localhost
REDIS_HOST=localhost

# Puerto de Redis.
# No obligatoria, no es secreto. Default: 6379
REDIS_PORT=6379

# Password de Redis.
# No obligatoria (solo si Redis la exige). SECRETO (Secret Manager). Default: vacío
REDIS_PASSWORD=

# Si la conexión a Redis usa TLS.
# No obligatoria, no es secreto. Default: true
REDIS_SSL=true

# ── Otros ────────────────────────────────────────────────────────────────

# PORT no se incluye aquí: Cloud Run lo inyecta automáticamente y el gateway
# ya lo respeta (server.port: ${PORT:8090}). No lo fijes a mano en Cloud Run.
